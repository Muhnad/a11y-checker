{
  "name": "a11y-checker",
  "version": "3.0.0-alpha.0",
  "description": "Accessibility scanner for humans and AI agents: CLI, MCP server and skill that return structured, fixable findings.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "a11y-checker": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'test/**/*.integration-test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhnad/a11y-checker.git"
  },
  "bugs": {
    "url": "https://github.com/Muhnad/a11y-checker/issues"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "wcag",
    "axe-core",
    "mcp",
    "ai-agents",
    "react",
    "nextjs",
    "react-native"
  ],
  "author": "Muhannad Abdelrazek",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "tsup": "^8.5.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@axe-core/playwright": "^4.13.0",
    "@babel/runtime": "^7.29.10",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ast-types-flow": "^0.0.7",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsx-ast-utils": "^3.3.5",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "zod": "^4.6.6"
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  }
}
