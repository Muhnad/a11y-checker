{
  "name": "a11y-checker",
  "version": "3.0.0-alpha.0",
  "description": "Accessibility scanner for humans and AI agents: CLI, MCP server and skill that return structured, fixable findings.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhnad/a11y-checker.git"
  },
  "bugs": {
    "url": "https://github.com/Muhnad/a11y-checker/issues"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "wcag",
    "axe-core",
    "mcp",
    "ai-agents",
    "react",
    "nextjs",
    "react-native"
  ],
  "author": "Muhannad Abdelrazek",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
